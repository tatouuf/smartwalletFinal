<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="500" prefWidth="800" style="-fx-background-color: #f5f7fb;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="esprit.tn.chayma.controllers.SettingController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: linear-gradient(to right, #4f46e5, #ec4899); -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 3);"
              prefHeight="60">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
            <Label text="⚙️" style="-fx-font-size: 24px; -fx-text-fill: white;"/>
            <Label text="Paramètres" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRetourDashboard" text="← Retour" onAction="#retourDashboard"
                    style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 5 12;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 25;">
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;">
                    <Label text="🌐 Langue"/>
                    <Separator/>
                    <HBox spacing="20">
                        <RadioButton fx:id="frenchRadio" text="Français" selected="true"/>
                        <RadioButton fx:id="englishRadio" text="English"/>
                        <RadioButton fx:id="arabicRadio" text="العربية"/>
                    </HBox>
                </VBox>
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;">
                    <Label text="🎨 Apparence"/>
                    <Separator/>
                    <HBox spacing="20">
                        <RadioButton fx:id="lightRadio" text="Clair" selected="true"/>
                        <RadioButton fx:id="darkRadio" text="Sombre"/>
                    </HBox>
                    <Label text="Taille de police"/>
                    <Slider fx:id="fontSizeSlider" min="10" max="24" value="14"/>
                    <Label fx:id="previewLabel" text="Aperçu du texte"/>
                    <CheckBox fx:id="animationsCheckbox" text="Activer animations" selected="true"/>
                </VBox>
                <Button fx:id="saveButton" text="Enregistrer"
                        style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
            <padding><Insets bottom="10" left="20" right="20" top="10"/></padding>
            <Label text="© 2026 SmartWallet" style="-fx-text-fill: #94a3b8;"/>
        </HBox>
    </bottom>
</BorderPane>