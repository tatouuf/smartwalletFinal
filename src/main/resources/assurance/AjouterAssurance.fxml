<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="550.0" prefWidth="900.0" style="-fx-background-color: #f5f7fb;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.assurance.AjouterAssurance">

    <!-- Header avec gradient -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: linear-gradient(to right, #4f46e5, #ec4899); -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 3);">
            <padding>
                <Insets top="15" right="25" bottom="15" left="25"/>
            </padding>
            <Label text="🔒" style="-fx-font-size: 28px; -fx-text-fill: white;"/>
            <Label text="SmartWallet" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="retouritaf" onAction="#retourMain" text="Retour"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand; -fx-padding: 8 20 8 20; -fx-font-size: 13px; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>
        </HBox>
    </top>

    <!-- Centre -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent;">
            <VBox spacing="20" alignment="TOP_CENTER">
                <padding>
                    <Insets top="20" left="30" right="30" bottom="20"/>
                </padding>

                <!-- Statistiques rapides -->
                <HBox spacing="20" alignment="CENTER">
                    <VBox spacing="5" style="-fx-background-color: linear-gradient(to bottom right, #4f46e5, #ec4899); -fx-background-radius: 15; -fx-padding: 12 20;" prefWidth="180">
                        <Label text="New Insurance" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-opacity: 0.8;"/>
                        <Label text="+" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="5" style="-fx-background-color: linear-gradient(to bottom right, #4f46e5, #ec4899); -fx-background-radius: 15; -fx-padding: 12 20;" prefWidth="180">
                        <Label text="Type" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-opacity: 0.8;"/>
                        <Label fx:id="typePreview" text="VOITURE" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="5" style="-fx-background-color: linear-gradient(to bottom right, #4f46e5, #ec4899); -fx-background-radius: 15; -fx-padding: 12 20;" prefWidth="180">
                        <Label text="Status" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-opacity: 0.8;"/>
                        <Label fx:id="statusPreview" text="ACTIVE" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>

                <Separator style="-fx-background-color: #e5e7eb;"/>

                <!-- Formulaire -->
                <HBox spacing="40" alignment="TOP_CENTER">

                    <!-- Formulaire gauche -->
                    <VBox spacing="20" prefWidth="380" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 4);">

                        <Label text="📝 Insurance Information" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4f46e5;"/>

                        <GridPane hgap="15" vgap="12">
                            <padding><Insets top="5"/></padding>

                            <Label text="Insurance Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <TextField fx:id="nomAssuranceField" prefWidth="240" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                       style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12;"/>

                            <Label text="Insurance Type:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <ComboBox fx:id="typeAssuranceCombo" prefWidth="240" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                      style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8;" onAction="#updateTypePreview"/>

                            <Label text="Amount (DT):" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <TextField fx:id="prixField" prefWidth="240" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                       style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12;"/>

                            <Label text="Duration (months):" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <TextField fx:id="dureeField" prefWidth="240" GridPane.rowIndex="3" GridPane.columnIndex="1"
                                       style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12;"/>

                            <Label text="Description:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <TextArea fx:id="descriptionField" prefWidth="240" prefHeight="60" GridPane.rowIndex="4" GridPane.columnIndex="1"
                                      style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;"/>

                            <Label text="Conditions:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <TextArea fx:id="conditionsField" prefWidth="240" prefHeight="60" GridPane.rowIndex="5" GridPane.columnIndex="1"
                                      style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;"/>

                            <Label text="Status:" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <ComboBox fx:id="statutCombo" prefWidth="240" GridPane.rowIndex="6" GridPane.columnIndex="1"
                                      style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8;" onAction="#updateStatusPreview"/>
                        </GridPane>

                        <Button fx:id="btnAjouterAssurance" onAction="#ajouterAssurance" text="➕ Add Insurance"
                                style="-fx-background-color: #7c3aed; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-padding: 12 20; -fx-font-size: 15px; -fx-cursor: hand; -fx-effect: dropshadow(two-pass-box, rgba(124,58,237,0.3), 8, 0, 0, 2);"
                                prefWidth="380"/>
                    </VBox>

                    <!-- Séparateur vertical -->
                    <Region prefWidth="2" style="-fx-background-color: #e5e7eb; -fx-background-radius: 1;"/>


                </HBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets bottom="15" left="25" right="25" top="15"/>
            </padding>
            <Label text="© 2026 SmartWallet - Insurance Management" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>