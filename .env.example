# Environment variables for SmartWallet
# Copy this file to .env and fill in the values

# HuggingFace API Key for AI Insights
HF_API_KEY=your_huggingface_api_key_here

# Email configuration for payment success notifications
EMAIL_USERNAME=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password_here

# Stripe configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Database configuration
DB_URL=jdbc:mysql://localhost:3306/smartwalletdb2?useSSL=false&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=

# User Session configuration
DEFAULT_USER_EMAIL=your_email@example.com
DEFAULT_USER_NAME=YourName
