<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600" prefWidth="900" style="-fx-background-color: #f5f7fb;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="esprit.tn.chayma.controllers.DepensesController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: linear-gradient(to right, #4f46e5, #ec4899); -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 3);"
              prefHeight="60">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
            <Label text="💰" style="-fx-font-size: 24px; -fx-text-fill: white;"/>
            <Label text="Gestion des Dépenses" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRetourDashboard" text="← Retour" onAction="#retourDashboard"
                    style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 5 12;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="15" style="-fx-padding: 20;">
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;">
                    <Label text="➕ Ajouter une dépense" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #4f46e5;"/>
                    <Separator/>
                    <GridPane hgap="10" vgap="10">
                        <Label text="Montant (DT)"/>
                        <TextField fx:id="montantField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Catégorie" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="categorieCombo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Date" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <DatePicker fx:id="dateDepenseField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="Description" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="descriptionField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </GridPane>
                    <HBox spacing="10">
                        <Button fx:id="ajouterBtn" text="Ajouter"/>
                        <Button fx:id="modifierBtn" text="Modifier"/>
                        <Button fx:id="supprimerBtn" text="Supprimer"/>
                    </HBox>
                </VBox>
                <ListView fx:id="depensesList" prefHeight="300"/>
                <Label fx:id="totalDepensesLabel"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
            <padding><Insets bottom="10" left="20" right="20" top="10"/></padding>
            <Label text="© 2026 SmartWallet" style="-fx-text-fill: #94a3b8;"/>
        </HBox>
    </bottom>
</BorderPane>