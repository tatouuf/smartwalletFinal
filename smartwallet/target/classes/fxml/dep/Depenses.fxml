<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650" prefWidth="1000" style="-fx-background-color: #f1f5f9; -fx-font-family: 'Segoe UI', system, 'Helvetica Neue', sans-serif;"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="esprit.tn.chayma.controllers.DepensesController">

    <top>
        <!-- Header moderne avec dégradé subtil -->
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: linear-gradient(to right, #1e293b, #0f172a); -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0.2, 0, 2);"
              prefHeight="70">
            <padding><Insets left="24" right="24" top="12" bottom="12"/></padding>
            <Label text="📊" style="-fx-font-size: 26px; -fx-text-fill: #ffffff;"/>
            <Label text="Gestion des dépenses" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white; -fx-letter-spacing: 0.5px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRetourDashboard" text="← Retour au tableau de bord" onAction="#retourDashboard"
                    style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: white; -fx-background-radius: 30px; -fx-padding: 8 20; -fx-font-size: 13px; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" hbarPolicy="NEVER">
            <VBox spacing="24" style="-fx-padding: 24 28 28 28;">
                <!-- Carte : Ajouter / Modifier une dépense -->
                <VBox spacing="16"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0.1, 0, 4); -fx-padding: 20 24 24 24;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="✏️" style="-fx-font-size: 18px;"/>
                        <Label text="Nouvelle dépense" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    </HBox>
                    <Separator style="-fx-background-color: #e2e8f0;"/>

                    <GridPane hgap="16" vgap="14" style="-fx-padding: 8 0 0 0;">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="100"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <children>
                            <Label text="Montant (DT)" style="-fx-font-weight: 600; -fx-text-fill: #334155;"/>
                            <TextField fx:id="montantField" promptText="Ex: 49.99"
                                       style="-fx-background-radius: 12; -fx-padding: 10 14; -fx-border-color: #cbd5e1; -fx-border-radius: 12; -fx-border-width: 1.2; -fx-background-color: white;" GridPane.columnIndex="1"/>

                            <Label text="Catégorie" style="-fx-font-weight: 600; -fx-text-fill: #334155;" GridPane.rowIndex="1"/>
                            <ComboBox fx:id="categorieCombo" promptText="Sélectionnez une catégorie"
                                      style="-fx-background-radius: 12; -fx-padding: 6 10; -fx-border-color: #cbd5e1; -fx-border-radius: 12; -fx-background-color: white;"
                                      GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="Date" style="-fx-font-weight: 600; -fx-text-fill: #334155;" GridPane.rowIndex="2"/>
                            <DatePicker fx:id="dateDepenseField" promptText="jj/mm/aaaa"
                                        style="-fx-background-radius: 12; -fx-border-color: #cbd5e1; -fx-border-radius: 12; -fx-background-color: white;"
                                        GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <Label text="Description" style="-fx-font-weight: 600; -fx-text-fill: #334155;" GridPane.rowIndex="3"/>
                            <TextField fx:id="descriptionField" promptText="Optionnel (ex: courses, essence...)"
                                       style="-fx-background-radius: 12; -fx-padding: 10 14; -fx-border-color: #cbd5e1; -fx-border-radius: 12; -fx-border-width: 1.2; -fx-background-color: white;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        </children>
                    </GridPane>

                    <HBox spacing="14" alignment="CENTER_RIGHT" style="-fx-padding: 12 0 0 0;">
                        <Button fx:id="ajouterBtn" text="➕ Ajouter"
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 30px; -fx-padding: 8 28; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;"/>
                        <Button fx:id="modifierBtn" text="✏️ Modifier"
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 30px; -fx-padding: 8 28; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;"/>
                        <Button fx:id="supprimerBtn" text="🗑️ Supprimer"
                                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 30px; -fx-padding: 8 28; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- Carte : Liste des dépenses -->
                <VBox spacing="14"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0.1, 0, 2); -fx-padding: 20 20 20 20;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📋" style="-fx-font-size: 18px;"/>
                        <Label text="Historique des dépenses" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    </HBox>
                    <Separator style="-fx-background-color: #e2e8f0;"/>
                    <ListView fx:id="depensesList" prefHeight="320"
                              style="-fx-background-color: transparent; -fx-background-radius: 14; -fx-border-color: #e2e8f0; -fx-border-radius: 14; -fx-padding: 4;">
                        <!-- Style pour les cellules (via CSS inline - s'applique au ListView, les cellules héritent) -->
                        <style>
                            .list-view .list-cell {
                            -fx-padding: 12 12;
                            -fx-background-color: white;
                            -fx-border-color: #f1f5f9;
                            -fx-font-size: 13px;
                            }
                            .list-view .list-cell:odd {
                            -fx-background-color: #fafcff;
                            }
                            .list-view .list-cell:selected {
                            -fx-background-color: #eef2ff;
                            -fx-text-fill: #1e293b;
                            -fx-border-color: #cbd5e1;
                            }
                        </style>
                    </ListView>
                </VBox>

                <!-- Carte : Total des dépenses -->
                <HBox alignment="CENTER_RIGHT"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2); -fx-padding: 16 24;">
                    <Label text="💰 Total des dépenses : " style="-fx-font-size: 15px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                    <Label fx:id="totalDepensesLabel" text="0.00 DT"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4f46e5; -fx-padding: 0 0 0 8;"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER"
              style="-fx-background-color: #ffffff; -fx-border-color: #e9eef3; -fx-border-width: 1 0 0 0; -fx-padding: 12 20;">
            <Label text="© 2026 SmartWallet — Gérez vos finances simplement"
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: 400;"/>
        </HBox>
    </bottom>
</BorderPane>