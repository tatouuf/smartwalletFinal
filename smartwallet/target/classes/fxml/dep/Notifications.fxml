<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="500" prefWidth="800" style="-fx-background-color: #f5f7fb;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="esprit.tn.chayma.controllers.NotificationsController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: linear-gradient(to right, #4f46e5, #ec4899); -fx-effect: dropshadow(two-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 3);"
              prefHeight="60">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
            <Label text="🔔" style="-fx-font-size: 24px; -fx-text-fill: white;"/>
            <Label text="Notifications" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRetourDashboard" text="← Retour" onAction="#retourDashboard"
                    style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 5 12;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15" alignment="CENTER" style="-fx-padding: 30;">
            <Label text="📭 Aucune nouvelle notification" style="-fx-font-size: 18px; -fx-text-fill: #64748b;"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
            <padding><Insets bottom="10" left="20" right="20" top="10"/></padding>
            <Label text="© 2026 SmartWallet" style="-fx-text-fill: #94a3b8;"/>
        </HBox>
    </bottom>
</BorderPane>