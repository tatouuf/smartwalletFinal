<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="esprit.tn.chayma.controllers.AdvisorController"
            prefHeight="700" prefWidth="1000"
            style="-fx-background-color: #f4f6f9;">

    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #1e3c2c, #2e7d32); -fx-padding: 20 25 20 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);">
            <Label text="🤖 Conseiller IA / AI Advisor"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'"/>
            <Label text="Analyse prédictive et recommandations financières"
                   style="-fx-text-fill: #d4e6d4; -fx-font-size: 13px; -fx-font-family: 'Segoe UI'"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 30; -fx-background-color: #f4f6f9;">
            <!-- Carte Filtres -->
            <VBox spacing="15"
                  style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2); -fx-padding: 20;">
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <Label text="📅 Période d'analyse"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e2f;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox spacing="25" alignment="CENTER_LEFT">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Mois :" style="-fx-font-weight: bold; -fx-text-fill: #2c3e2f;"/>
                        <ComboBox fx:id="moisCombo" prefWidth="130" promptText="Sélectionner"
                                  style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 5 10;">
                            <tooltip>
                                <Tooltip text="Choisissez le mois à analyser"/>
                            </tooltip>
                        </ComboBox>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Année :" style="-fx-font-weight: bold; -fx-text-fill: #2c3e2f;"/>
                        <ComboBox fx:id="anneeCombo" prefWidth="110" promptText="Sélectionner"
                                  style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 5 10;">
                            <tooltip>
                                <Tooltip text="Choisissez l'année"/>
                            </tooltip>
                        </ComboBox>
                    </HBox>
                    <Button fx:id="analyzeBtn" text="🔍 Analyser"
                            style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 8 20; -fx-cursor: hand;">
                        <tooltip>
                            <Tooltip text="Lancer l'analyse IA"/>
                        </tooltip>
                    </Button>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- Zone des conseils -->
            <VBox spacing="10"
                  style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2); -fx-padding: 20;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="💡 Recommandations IA" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e2f;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="statusLabel" text="Prêt" style="-fx-text-fill: #5a6e5a; -fx-font-size: 11px;" managed="false" visible="false"/>
                </HBox>
                <TextArea fx:id="adviceArea" wrapText="true" editable="false"
                          prefHeight="380"
                          style="-fx-font-family: 'Segoe UI', monospace; -fx-font-size: 13px; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e4e8; -fx-background-insets: 0; -fx-padding: 12; -fx-control-inner-background: #fefdf8;">
                    <tooltip>
                        <Tooltip text="Rapport généré par l'assistant IA"/>
                    </tooltip>
                </TextArea>
            </VBox>

            <!-- Actions -->
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button fx:id="refreshBtn" text="🔄 Rafraîchir"
                        style="-fx-background-color: #f5f5f5; -fx-text-fill: #2e7d32; -fx-border-color: #c8e6c9; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 8 18; -fx-cursor: hand;">
                    <tooltip>
                        <Tooltip text="Rafraîchir les données et conseils"/>
                    </tooltip>
                </Button>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox style="-fx-background-color: #e9edf2; -fx-padding: 8 20; -fx-spacing: 10;" alignment="CENTER_RIGHT">
            <Label text="⚡ Analyse IA en temps réel" style="-fx-text-fill: #4a5b4a; -fx-font-size: 11px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="v1.2 — Module Conseiller" style="-fx-text-fill: #7a8a7a; -fx-font-size: 10px;"/>
        </HBox>
    </bottom>

</BorderPane>