<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="mainContainer"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="esprit.tn.chayma.controllers.DeplayoutController"
            prefWidth="1280" prefHeight="720"
            style="-fx-background-color: #f1f5f9;">

    <!-- ========== SIDEBAR GAUCHE ========== -->
    <left>
        <VBox spacing="8"
              style="-fx-background-color: linear-gradient(to bottom, #0f172a, #1e293b); -fx-padding: 30 15 25 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 3, 0);"
              prefWidth="280">

            <!-- Logo / Branding -->
            <VBox spacing="10" alignment="CENTER" style="-fx-padding: 0 0 20 0;">
                <Circle radius="35" fill="#3b82f6" stroke="white" strokeWidth="2"/>
                <Label text="SmartWallet"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
                <Label text="Gestion intelligente"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
                <Separator style="-fx-background-color: #334155; -fx-pref-height: 1;"/>
            </VBox>

            <!-- Navigation -->
            <Button text="🏠 Dashboard" onAction="#goDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-font-size: 14px; -fx-padding: 12 20; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12; -fx-font-family: 'Segoe UI';"/>
            <Button text="📅 Plannings" onAction="#goPlannings"
                    style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-font-size: 14px; -fx-padding: 12 20; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12; -fx-font-family: 'Segoe UI';"/>
            <Button text="💰 Budget" onAction="#goBudget"
                    style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-font-size: 14px; -fx-padding: 12 20; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12; -fx-font-family: 'Segoe UI';"/>
            <Button text="📝 Dépenses" onAction="#goDepenses"
                    style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-font-size: 14px; -fx-padding: 12 20; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12; -fx-font-family: 'Segoe UI';"/>
            <Button text="🔔 Notifications" onAction="#goNotifications"
                    style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-font-size: 14px; -fx-padding: 12 20; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12; -fx-font-family: 'Segoe UI';"/>
            <Button text="🧑‍💼 Advisor" onAction="#goAdvisor"
                    style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-font-size: 14px; -fx-padding: 12 20; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12; -fx-font-family: 'Segoe UI';"/>
            <Button text="⚙️ Settings" onAction="#goSettings"
                    style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-font-size: 14px; -fx-padding: 12 20; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12; -fx-font-family: 'Segoe UI';"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Pied de sidebar -->
            <VBox spacing="12">
                <Separator style="-fx-background-color: #334155;"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Circle radius="6" fill="#10b981"/>
                    <Label text="Statut : connecté"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
                </HBox>
                <Button text="⬅ Se déconnecter" onAction="#goBack"
                        style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 20; -fx-background-radius: 12; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;"/>
                <Label text="Version 3.2.0"
                       style="-fx-text-fill: #64748b; -fx-font-size: 10px; -fx-alignment: center;"/>
            </VBox>
        </VBox>
    </left>

    <!-- ========== ZONE CENTRALE ========== -->
    <center>
        <VBox spacing="0">
            <!-- Header supérieur -->
            <HBox alignment="CENTER_LEFT" spacing="15" prefHeight="70"
                  style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2); -fx-padding: 0 30;">
                <Label fx:id="pageTitle" text="Dashboard"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a; -fx-font-family: 'Segoe UI';"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER">
                    <Circle radius="6" fill="#22c55e"/>
                    <Label text="En ligne"
                           style="-fx-text-fill: #475569; -fx-font-size: 13px;"/>
                    <Circle radius="16" fill="#3b82f6" stroke="#e2e8f0" strokeWidth="2"/>
                    <Label text="Admin"
                           style="-fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                </HBox>
            </HBox>

            <!-- Contenu dynamique avec carte -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="20" style="-fx-padding: 25;">
                    <StackPane fx:id="contentArea"
                               style="-fx-background-color: white; -fx-background-radius: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 12, 0, 0, 3); -fx-padding: 25;">
                        <Label text="Bienvenue dans SmartWallet"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;"/>
                    </StackPane>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>