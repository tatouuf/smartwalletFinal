<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="esprit.tn.chayma.controllers.AdvisorController"
            prefHeight="700" prefWidth="1000"
            style="-fx-background-color: #f4f6f9;">

    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #1e3c2c, #2e7d32); -fx-padding: 20 25;">
            <Label text="🤖 Conseiller IA / AI Advisor"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label text="Posez n'importe quelle question ou analysez votre budget"
                   style="-fx-text-fill: #d4e6d4; -fx-font-size: 13px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 30;">

            <!-- Zone d'analyse prédictive -->
            <VBox spacing="15"
                  style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 20;">
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <Label text="📅 Analyse mensuelle" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox spacing="25" alignment="CENTER_LEFT">
                    <HBox spacing="10">
                        <Label text="Mois :" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="moisCombo" prefWidth="130"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Année :" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="anneeCombo" prefWidth="110"/>
                    </HBox>
                    <Button fx:id="analyzeBtn" text="🔍 Analyser"
                            style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 8 20;"/>
                </HBox>
                <TextArea fx:id="adviceArea" wrapText="true" editable="false"
                          prefHeight="150"
                          style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-background-radius: 10;"/>
            </VBox>

            <!-- Zone de chat IA -->
            <VBox spacing="15"
                  style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 20;"
                  VBox.vgrow="ALWAYS">
                <Label text="💬 Dialogue avec l'assistant IA" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <TextArea fx:id="chatHistory" editable="false" wrapText="true"
                          prefHeight="300"
                          style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-background-radius: 8;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="questionField" promptText="Posez votre question (ex: comment réduire mes dépenses ?)"
                               HBox.hgrow="ALWAYS" style="-fx-background-radius: 20;"/>
                    <Button fx:id="sendBtn" text="Envoyer"
                            style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 6 20;"/>
                    <ProgressIndicator fx:id="loadingIndicator" prefWidth="30" visible="false"/>
                </HBox>
            </VBox>

            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button fx:id="refreshBtn" text="🔄 Rafraîchir"
                        style="-fx-background-color: #f5f5f5; -fx-text-fill: #2e7d32; -fx-border-color: #c8e6c9; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 8 18;"/>
            </HBox>

        </VBox>
    </center>

    <bottom>
        <HBox style="-fx-background-color: #e9edf2; -fx-padding: 8 20;" alignment="CENTER_RIGHT">
            <Label text="⚡ IA conversationnelle (OpenAI / Ollama)" style="-fx-text-fill: #4a5b4a; -fx-font-size: 11px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="SmartWallet v2.0" style="-fx-text-fill: #7a8a7a; -fx-font-size: 10px;"/>
        </HBox>
    </bottom>

</BorderPane>