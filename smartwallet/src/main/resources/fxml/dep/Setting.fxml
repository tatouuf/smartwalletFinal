<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" prefHeight="550" prefWidth="850" styleClass="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="esprit.tn.chayma.controllers.SettingController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="header" prefHeight="70">
            <padding><Insets left="25" right="25"/></padding>
            <Label text="⚙️" style="-fx-font-size: 28px;"/>
            <Label text="Paramètres" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRetourDashboard" text="← Retour" onAction="#retourDashboard" styleClass="back-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" hbarPolicy="NEVER">
            <VBox spacing="25" style="-fx-padding: 30;">
                <!-- Carte Thème -->
                <VBox spacing="15" styleClass="card">
                    <Label text="🎨 Apparence" styleClass="card-title"/>
                    <Separator styleClass="separator"/>

                    <HBox spacing="20" alignment="CENTER">
                        <VBox fx:id="lightThemeBox" alignment="CENTER" spacing="10" styleClass="theme-card" style="-fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1;">
                            <Label text="☀️" style="-fx-font-size: 32px;"/>
                            <Label text="Clair" style="-fx-font-weight: bold;"/>
                        </VBox>
                        <VBox fx:id="darkThemeBox" alignment="CENTER" spacing="10" styleClass="theme-card" style="-fx-background-color: #1e293b; -fx-border-color: #475569;">
                            <Label text="🌙" style="-fx-font-size: 32px;"/>
                            <Label text="Sombre" style="-fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
                        </VBox>
                    </HBox>

                    <Label text="Aperçu" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="previewLabel" text="Ceci est un aperçu du thème actuel" styleClass="preview-box"/>
                </VBox>

                <!-- Carte Police & Animations -->
                <VBox spacing="15" styleClass="card">
                    <Label text="🔤 Affichage" styleClass="card-title"/>
                    <Separator/>
                    <Label text="Taille de police :"/>
                    <Slider fx:id="fontSizeSlider" min="10" max="24" value="14" showTickLabels="true" showTickMarks="true" majorTickUnit="2" minorTickCount="1"/>
                    <Label fx:id="previewFontLabel" text="Exemple de texte avec la taille choisie"/>
                    <CheckBox fx:id="animationsCheckbox" text="Activer les animations" selected="true"/>
                </VBox>

                <Button fx:id="saveButton" text="💾 Enregistrer les préférences" onAction="#savePreferences" styleClass="save-button"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" styleClass="footer">
            <padding><Insets bottom="12" left="25" right="25" top="12"/></padding>
            <Label text="© 2026 SmartWallet — Version 2.0" style="-fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>